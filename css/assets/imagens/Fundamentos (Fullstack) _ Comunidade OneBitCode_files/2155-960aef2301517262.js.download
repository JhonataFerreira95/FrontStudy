xt:"Supportive Peer Network",pText:"Ongoing accountability and shared learning with leaders who are committed to growth and excellence. Unlike social media groups, our community is carefully curated for quality conversations and real support."},{image:{signedId:"",placeholder:p},h5Text:"Exclusive Content & Insights",pText:"Early access to leadership frameworks, guest experts, and case studies to accelerate your development. Members get resources worth thousands of dollars that aren't available anywhere else."}].map(function(e){return(0,o.g)(e)})},footer:{prop:"children",type:"children",value:[(0,i.Ot)({text:"Start Connecting with Like-Minded Leaders Today",href:"#"}),(0,i.FA)({text:"Limited membership spots available this quarter",paragraphStyle:"p3"})]},styles:{prop:"styles",type:"styles",value:{backgroundColor:(0,c.GT)({defaultValue:m.ZS.backgroundColor}),backgroundImage:(0,u.e)(),padding:(0,l.e)({defaultValue:m.ZS.padding}),margin:(0,l._)({defaultValue:m.ZS.margin})}}}}},36029:function(e,t,r){"use strict";r.d(t,{d:()=>g});var n=r(21530),o=r(15036),a=r(70527),i=r(61574),l=r(10249),c=r(90667),s=r(9993),u=r(25826),d=r(85155),p=r(66684),f=r(42695),b=r(38505),y=r(3752),m=r(96298),g={id:(0,n.Z)(),type:"HomepageBlock7",props:{header:{prop:"children",type:"children",value:[(0,d.xJ)({text:"Real Leaders. Real Growth"}),(0,d.FA)({text:"From career pivots to executive breakthroughs, our coaching and community have empowered leaders to achieve their biggest goals."})]},cards:{prop:"children",type:"children",value:[{image:{signedId:"",placeholder:o},user:{name:"Sarah Johnson",position:"CEO, TechVision Inc."},quote:"“Before joining Clarity Coaching, I struggled with imposter syndrome as a new CEO. The group coaching sessions gave me the support, confidence, and clarity I needed to succeed.”",description:"Results: Improved team retention by 35%, successful company pivot, increased revenue by $2.3M"},{image:{signedId:"",placeholder:a},user:{name:"Michael Chen",position:"SVP of Operations, Global Logistics"},quote:"“I was stuck in middle management for 5 years before joining the Clarity leadership Collective. The combination of expert coaching and peer-driven accountability accelerated my success. Within 90 days, I implemented a new operational framework that caught the attention of senior leadership, and within months, I was promoted to SVP.”",description:"Results: Promoted from Director to SVP, led successful international expansion, 42% salary increase"},{image:{signedId:"",placeholder:i},user:{name:"David Wilson",position:"CFO, Healthcare Innovation"},quote:"“I was a technical expert with zero leadership training when I was suddenly promoted to CFO. Being part of the Clarity community while receiving 1:1 coaching helped me develop the executive presence and strategic thinking skills I desperately needed. The combination of personal guidance and peer support made all the difference. I went from feeling overwhelmed to confidently leading our $50M fundraising round in just 4 months.”",description:"Results: Successfully transitioned from Finance Director to CFO, led $50M fundraising round, implemented new financial systems that saved $1.2M annually"},{image:{signedId:"",placeholder:l},user:{name:"Jennifer Martines",position:"Director of Sales, Retail Solutions"},quote:"“My team was underperforming and I was on the verge of being let go. The mastermind sessions transformed our dysfunctional team into a high-performing unit. We developed a shared vision and the communication tools needed to execute effectively, with ongoing support from both the coach and community members. Within one quarter, we went from the bottom-performing team to the top.“",description:"Results: 48% sales increase, reduced team conflict, improved customer satisfaction scores from 72% to 94%"}].map(function(e){var t=e.image,r=e.user,n=e.quote,o=e.description,a=[(0,u.P)({image:t,header:r.name,description:r.position}),(0,d.Nj)({text:n,styles:{fontSize:(0,y.yw)("1.125rem")}}