        visibility: visible;
        opacity: 1;
      }

      @media (hover: hover) {
        :host(:is([${ts.vH.MEDIA_PREVIEW_IMAGE}], [${ts.vH.MEDIA_PREVIEW_TIME}]):hover) [part~="preview-box"] {
          transition-duration: var(--media-preview-transition-duration-in, .5s);
          transition-delay: var(--media-preview-transition-delay-in, .25s);
          visibility: visible;
          opacity: 1;
        }
      }

      media-preview-thumbnail,
